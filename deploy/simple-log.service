# The app as a service: starts on boot, restarts if it stops.
# setup.sh fills in __USER__ and __APP_DIR__ and copies this to /etc/systemd/system/.
[Unit]
Description=simple-log
After=network.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=PORT=8090
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
